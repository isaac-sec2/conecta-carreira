# Copie para .env e preencha:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# Chave do Gemini (NUNCA commite o .env!)
GEMINI_KEY=cole_sua_chave_aqui

# Modelo (opcional)
GEMINI_MODEL=gemini-2.5-flash-lite

# Porta do servidor (opcional)
PORT=5000

# CORS restrito (recomendado em produção, separado por vírgula).
# Ex: ALLOWED_ORIGINS=https://seu-site.vercel.app,https://seu-dominio.com
# Vazio = libera geral (só p/ desenvolvimento local).
ALLOWED_ORIGINS=

# Rate limit (opcional): requisições/min por IP em /api/gemini
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
